# The site is static and reads no environment variables at runtime.
# Site metadata (canonical URL, OG image) is hardcoded in src/lib/seo.ts.
#
# The only variable read anywhere is the optional dev-server flag below,
# consumed by vite.config.ts. Leave it unset for normal development.

# DISABLE_HMR: set to "true" to turn off hot module replacement and file
# watching. Useful when an editing tool causes flicker on rapid file writes.
# DISABLE_HMR="true"
